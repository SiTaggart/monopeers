{
  "search.exclude": {
    "**/coverage": true,
    "dist": true
  },
  "oxc.path.oxfmt": "./node_modules/oxfmt/bin/oxfmt",
  "oxc.path.oxlint": "./node_modules/oxlint/bin/oxlint",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
